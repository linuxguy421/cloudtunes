# Host port for the CloudTunes web interface.
WEB_PORT=8080

# Host port for the Icecast stream/status endpoint.
ICECAST_PORT=8000

# URL that listeners' browsers use to reach Icecast.
# Set this to the hostname/IP of the Docker host when accessing remotely.
# If ICECAST_PORT changes, update this URL to match.
ICECAST_PUBLIC_URL=http://localhost:8000
