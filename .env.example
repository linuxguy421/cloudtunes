# Host port for the Laravel CloudTunes web interface.
CONTROL_PLANE_PORT=8080
APP_URL=http://localhost:8080

# Host port for the Icecast stream/status endpoint.
ICECAST_PORT=8000

# URL that listeners' browsers use to reach Icecast.
# Set this to a host name/IP reachable from listener browsers.
# If ICECAST_PORT changes, update this URL to match.
ICECAST_PUBLIC_URL=http://localhost:8000
ICECAST_MOUNT=/default0.ogg

# Generate once and keep stable across upgrades:
#   php -r 'echo "base64:".base64_encode(random_bytes(32)).PHP_EOL;'
CONTROL_PLANE_APP_KEY=

# Generate a long random database password and keep it in this file.
CONTROL_PLANE_DB_PASSWORD=

# Set true when CloudTunes is served over HTTPS (recommended for production).
SESSION_SECURE_COOKIE=false

# Public account registration is enabled by default.
CLOUDTUNES_PUBLIC_REGISTRATION_ENABLED=true

# Optional Last.fm artwork fallback key.
LASTFM_API_KEY=

# Before starting Compose, create Icecast/Ices credential files with:
#   bash scripts/init-secrets.sh
# Secret files are stored under ./secrets/ and are excluded from Git.
